# Copy this file to `.env` and fill in your key.
# Get a FREE Groq API key: https://console.groq.com/keys  (keys start with gsk_)
GROQ_API_KEY=your-free-groq-key-here

# Optional — override the model (default: openai/gpt-oss-120b, best tool-calling on Groq).
# GROQ_MODEL=openai/gpt-oss-120b

# NOTE: this project needs Python 3.10+ (the MCP SDK requires it).
